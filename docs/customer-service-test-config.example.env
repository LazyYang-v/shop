# Copy to .env.customer-service-test.local (ignored). Fill locally; never paste secrets in chat.
# This template authorizes no network calls by itself.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Choose an exact official model; provider is confirmed, model is not yet approved.
DEEPSEEK_MODEL=
# Dedicated MCP endpoint and least-privilege TEST-only token. Do not reuse the screenshot token.
WEKNORA_TEST_MCP_URL=
WEKNORA_TEST_MCP_TOKEN=
WEKNORA_TEST_KNOWLEDGE_BASE_ID=
# Read-only calls may use only the explicitly named test knowledge base.
# Keep false until creation/update/deletion of synthetic test entries is approved.
WEKNORA_TEST_ALLOW_MUTATIONS=false
